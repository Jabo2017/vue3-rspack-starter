{
  "name": "vue3-rspack-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Vue 3 + TypeScript + Rspack 起步模板，内置 Vue2 遗留代码扫描器（迁移成本量化）",
  "scripts": {
    "dev": "rspack serve",
    "build": "rspack build",
    "preview": "node scripts/serve-dist.mjs",
    "scan": "node scripts/scan-legacy.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.5",
    "@rspack/core": "^2.2.5",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "rspack-vue-loader": "^17.7.0",
    "typescript": "5.9",
    "vitest": "^5.0.1",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.11"
  }
}
